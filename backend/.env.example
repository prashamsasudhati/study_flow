PORT=3000
NODE_ENV=development

# Configure this in Phase 3 after creating your MongoDB Atlas cluster.
MONGODB_URI=

# Replace with a long, unique random value of at least 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Comma-separated frontend origins. Live Server commonly uses port 5500.
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
